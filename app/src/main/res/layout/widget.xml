        android:text="SportCal · próximos eventos" android:textColor="#FFB800" android:textStyle="bold" android:textSize="13sp" />
    <TextView android:id="@+id/e1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="12sp" />
    <TextView android:id="@+id/e2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="12sp" />
    <TextView android:id="@+id/e3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="12sp" />
</LinearLayout>
